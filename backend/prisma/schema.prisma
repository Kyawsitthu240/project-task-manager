generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id        Int      @id @default(autoincrement())
  text      String
  priority  String
  deadline  String?
  status    String   @default("To Do")
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}